# Frontend environment configuration. Copy to `.env.local` (gitignored) to override locally.
# See PRD §13.2 (the cross-origin cookie trap) and lib/api.ts for how these are used.

# Server-side only: where next.config.mjs's rewrite proxy AND Server Component fetches (the public
# catalog pages) reach the FastAPI backend. Same-origin from the browser's point of view either way.
BACKEND_ORIGIN=http://localhost:8000

# Client-side escape hatch for a genuinely split deployment (frontend and backend on different
# hosts/domains). Leave unset for the default, preferred same-origin topology — client requests then
# go out as relative /api/* paths through the rewrite above, and credentials: "include" reliably
# carries the httpOnly auth cookie without any SameSite=None configuration.
#
# If you DO set this to a cross-origin URL, the backend must run with COOKIE_SAMESITE=none (+ Secure)
# and a credentialed CORS allow-list naming this exact origin, or auth will silently fail.
NEXT_PUBLIC_API_BASE=
