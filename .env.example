# SmartReco environment configuration.
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
# See CLAUDE.md invariant #4 and PRD §13.4. Every variable below becomes a platform environment
# variable when deployed; it is never baked into the image.

# --- app ---
ENVIRONMENT=local                 # local | production
LOG_LEVEL=INFO
APP_NAME=SmartReco
PORT=8000

# --- postgres (used by docker-compose AND to build DATABASE_URL below) ---
POSTGRES_USER=smartreco
POSTGRES_PASSWORD=smartreco_local_dev
POSTGRES_DB=smartreco
POSTGRES_PORT=5432

# DATABASE_URL — Neon connection string with ?sslmode=require when deployed.
DATABASE_URL=postgresql+asyncpg://smartreco:smartreco_local_dev@localhost:5432/smartreco

# --- qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- redis (Upstash URL when deployed) ---
REDIS_URL=redis://localhost:6379/0

# --- mesh api (the only LLM/embedding provider — CLAUDE.md invariant #1) ---
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_DISABLED=false               # true only locally, when developing without burning quota
# Optional per-tier model overrides. Empty = the free-first router (app/llm/model_router.py) decides.
# Pin fast paid models here once the Mesh account has a balance so the agent finishes inside its 25s
# budget instead of timing out to the deterministic fallback. Must be valid Mesh model ids.
MESH_CHEAP_MODEL=                  # e.g. openai/gpt-4o-mini  (plan / grade / refine)
MESH_QUALITY_MODEL=               # e.g. openai/gpt-4.1-mini (the generate narrative)
AGENT_TIMEOUT_SECONDS=25          # agent wall-clock cap (s); raise if the Mesh gateway is slow

# --- auth ---
JWT_SECRET=dev-insecure-secret-change-me   # rotate; never reuse the local dev value in production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# --- cookies / CORS ---
COOKIE_SAMESITE=lax               # lax | none — see PRD §13.2
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- digest email (bonus, F7) — SMTP_* or RESEND_API_KEY ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=

# --- observability (bonus, F8) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco
LANGSMITH_TRACING=false

# --- scheduled digest trigger (GitHub Actions calls this, protected — PRD §13.3) ---
DIGEST_TRIGGER_TOKEN=
